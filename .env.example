# llama.cpp server URL
LLAMA_URL=http://localhost:8080

# Web server port
PORT=3000

# Max context tokens — ONLY a fallback for when the server's /slots is unreachable.
# The real limit is read live from the slot's n_ctx, so normally you never touch this.
# Set it to match your llama-server --ctx-size: if it is larger than the true window, the
# tool loop believes it has room it does not have and walks into the wall instead of
# winding down at 80%. Undershooting is the safe direction.
# LLAMA_MAX_CONTEXT=64000

# Chars of the previous step's output each task-pipeline step receives (default 32000, ~9K tokens).
# This is the pipeline's ONLY channel between steps — a step sees this and nothing else.
# Unlike the tool-loop context budget, it does NOT scale with the slot's n_ctx: raising
# --ctx-size buys nothing here, so raise this too when you move to a bigger window.
# Too low and later steps lose detail from earlier ones; too high and a single fat step
# can push the next one straight into its own context wind-down before it does any work.
# MAX_PREV_RESULT_CHARS=32000

# LLM backend: 'llama' (default) or 'claude' (switchable at runtime)
# LLM_BACKEND=llama

# Claude API (required if using claude backend)
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MAX_TOKENS=8192

# Search engine: 'keiro' (default), 'tavily', or 'both'
# SEARCH_ENGINE=keiro

# Keiro search API key (get one at https://keirolabs.cloud)
# KEIRO_API_KEY=keiro-your-key-here

# Tavily search API key (optional, get one at https://tavily.com)
# TAVILY_API_KEY=tvly-your-key-here

# E*TRADE API (get keys at https://developer.etrade.com)
# ETRADE_CONSUMER_KEY=your-consumer-key
# ETRADE_CONSUMER_SECRET=your-consumer-secret
# ETRADE_SANDBOX=true

# LiteAPI hotel/travel API (get keys at https://www.liteapi.travel)
# LITEAPI_KEY=sand_your-key-here

# Python virtual environment path for run_python tool (optional)
# PYTHON_VENV=~/uv_python_env

# Keiro API base URL (optional, default: https://kierolabs.space/api)
# KEIRO_BASE_URL=https://kierolabs.space/api

# Stealth web fetch: use got-scraping (browser impersonation) instead of plain fetch
# Bypasses Cloudflare and anti-bot guards via TLS fingerprinting
# STEALTH_FETCH=true

# User location for weather/travel queries and {$location} macro (optional)
# LOCATION=New York, NY

# Project root path for source tools — self-awareness + code editing (optional)
# SOURCE_DIR=/path/to/this/project

# Test command for source_test tool — runs in SOURCE_DIR (optional)
# The LLM calls this after making code changes to verify they work.
# Set to whatever test/check command your project uses:
#   Node.js:  SOURCE_TEST=npm test
#   Python:   SOURCE_TEST=pytest -x
#   Go:       SOURCE_TEST=go test ./...
#   Rust:     SOURCE_TEST=cargo test
#   Java:     SOURCE_TEST=mvn test
#   C/C++:    SOURCE_TEST=make test
#   Ruby:     SOURCE_TEST=bundle exec rspec
#   PHP:      SOURCE_TEST=./vendor/bin/phpunit
#   .NET:     SOURCE_TEST=dotnet test
#   Elixir:   SOURCE_TEST=mix test
#   Syntax only (Node): SOURCE_TEST=node --check src/**/*.js
# SOURCE_TEST=npm test

# Terminal emulator for "Open Terminal" button (opens in project directory)
# Common options:
#   TERMINAL=cosmic-term          # Pop!_OS COSMIC
#   TERMINAL=gnome-terminal       # GNOME
#   TERMINAL=konsole              # KDE
#   TERMINAL=xfce4-terminal       # XFCE
#   TERMINAL=kitty
#   TERMINAL=alacritty
#   TERMINAL=xterm
# TERMINAL=cosmic-term

# Router decision logging — writes one JSONL record per tool-loop routing decision to
# logs/routes_YYYY-MM-DD.jsonl. Pure observation, no behavior change. See GRAPH_EXPLORATION.md.
# ROUTE_LOG=1
