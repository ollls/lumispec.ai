# llama.cpp server URL
LLAMA_URL=http://localhost:8080

# Web server port
PORT=3000

# Max context tokens — ONLY a fallback for when the server's /slots is unreachable.
# The real limit is read live from the slot's n_ctx, so normally you never touch this.
# Set it to match your llama-server --ctx-size: if it is larger than the true window, the
# tool loop believes it has room it does not have and walks into the wall instead of
# winding down at 80%. Undershooting is the safe direction.
# Examples: 64000 for the 4-slot layout, 114688 for the one-slot layout recommended on a 32 GB card
# (README, "Choosing a slot layout for llama-server"). The 4 default slots share ONE pool of --ctx-size
# tokens — they do not get that many each. With --parallel 4 --no-kv-unified, --ctx-size is divided by 4:
# set this to the per-slot share.
# LLAMA_MAX_CONTEXT=64000

# Per-answer cap on generated tokens (reasoning + content), sent as max_tokens on every streaming
# completion. Default 24576; 0 disables. Bounds a runaway generation to minutes, not the context wall.
# LLAMA_MAX_COMPLETION_TOKENS=24576

# Chars of the previous step's output each task-pipeline step receives (default 32000, ~9K tokens).
# This is the pipeline's ONLY channel between steps — a step sees this and nothing else.
# Unlike the tool-loop context budget, it does NOT scale with the slot's n_ctx: raising
# --ctx-size buys nothing here, so raise this too when you move to a bigger window.
# Too low and later steps lose detail from earlier ones; too high and a single fat step
# can push the next one straight into its own context wind-down before it does any work.
#
# Subtask groups ACCUMULATE before this cap applies: every sibling's output is joined
# (with "## <subtask>" headers) into one string, and the step after the group gets the
# FIRST N chars of that string. It is a head cut, not a window — the last siblings are
# dropped whole. The cut is not an error: the step runs on what survived, and the run shows
# an amber "Previous output cut to N of X chars" line naming the dropped sections (also a
# server warning, a {context_truncated} SSE event, and a notice at the top of the model's
# previous-output block). 13 news-site fetches at 3–5.6K chars each merged to 60K; the
# dashboard step saw 7½ outlets (2026-11-03). Size it for (siblings × per-subtask output), or keep the
# subtasks terse (e.g. "at most 6 headlines, one line each"). Flat tasks never
# accumulate: each sees only the one preceding step's output, cut the same way.
# MAX_PREV_RESULT_CHARS=32000

# LLM backend: 'llama' (default) or 'claude' (switchable at runtime)
# LLM_BACKEND=llama

# Claude API (required if using claude backend)
# CLAUDE_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_MAX_TOKENS=8192

# Search engine: 'keiro' (default), 'tavily', or 'both'
# SEARCH_ENGINE=keiro

# Keiro search API key (get one at https://keirolabs.cloud)
# KEIRO_API_KEY=keiro-your-key-here

# Tavily search API key (optional, get one at https://tavily.com)
# TAVILY_API_KEY=tvly-your-key-here

# E*TRADE API (get keys at https://developer.etrade.com)
# ETRADE_CONSUMER_KEY=your-consumer-key
# ETRADE_CONSUMER_SECRET=your-consumer-secret
# ETRADE_SANDBOX=true

# LiteAPI hotel/travel API (get keys at https://www.liteapi.travel)
# LITEAPI_KEY=sand_your-key-here

# Python environment for run_python and shell commands in source_run (optional). Any directory with
# bin/python works: venv, virtualenv, uv, pyenv, conda. The app detects which and tells the model the
# matching install command (uv pip / python -m pip / conda). Unset: the python3 on PATH, packages
# via `python3 -m pip install --user`.
# PYTHON_VENV=~/uv_python_env

# Keiro API base URL (optional, default: https://kierolabs.space/api)
# KEIRO_BASE_URL=https://kierolabs.space/api

# Stealth web fetch: use got-scraping (browser impersonation) instead of plain fetch
# Bypasses Cloudflare and anti-bot guards via TLS fingerprinting
# STEALTH_FETCH=true

# User location for weather/travel queries and {$location} macro (optional)
# LOCATION=New York, NY

# Project root path for source tools — self-awareness + code editing (optional)
# SOURCE_DIR=/path/to/this/project

# Test command for source_test tool — runs in SOURCE_DIR (optional)
# The LLM calls this after making code changes to verify they work.
# Set to whatever test/check command your project uses:
#   Node.js:  SOURCE_TEST=npm test
#   Python:   SOURCE_TEST=pytest -x
#   Go:       SOURCE_TEST=go test ./...
#   Rust:     SOURCE_TEST=cargo test
#   Java:     SOURCE_TEST=mvn test
#   C/C++:    SOURCE_TEST=make test
#   Ruby:     SOURCE_TEST=bundle exec rspec
#   PHP:      SOURCE_TEST=./vendor/bin/phpunit
#   .NET:     SOURCE_TEST=dotnet test
#   Elixir:   SOURCE_TEST=mix test
#   Syntax only (Node): SOURCE_TEST=node --check src/**/*.js
# SOURCE_TEST=npm test

# Terminal emulator for "Open Terminal" button (opens in project directory)
# Common options:
#   TERMINAL=cosmic-term          # Pop!_OS COSMIC
#   TERMINAL=gnome-terminal       # GNOME
#   TERMINAL=konsole              # KDE
#   TERMINAL=xfce4-terminal       # XFCE
#   TERMINAL=kitty
#   TERMINAL=alacritty
#   TERMINAL=xterm
# TERMINAL=cosmic-term

# Router decision logging — writes one JSONL record per tool-loop routing decision to
# logs/routes_YYYY-MM-DD.jsonl. Pure observation, no behavior change. See GRAPH_EXPLORATION.md.
# ROUTE_LOG=1

# LLM review of every template saved with "Save as Template" (on by default). The raw template is
# saved first; the review rewrites placeholders/hardcoded data into runtime /files/ loading, adds
# error handling and the resize message, and is applied only if the answer passes the output guard.
# Set to 0 to save templates raw; the ⚡ button in the Templates menu still reviews on demand.
# TEMPLATE_AUTO_REVIEW=0

# Browser Search (Chrome extension in extension/). Optional shared secret the extension must
# send as ?token= when connecting to ws://localhost:PORT/ws/browser. Set the same value in the
# extension popup. Leave unset to accept any loopback connection.
# BROWSER_SEARCH_TOKEN=change-me
# How long web_search / web_fetch wait for the extension before falling back (ms, default 25000)
# BROWSER_SEARCH_TIMEOUT_MS=25000
# Browser the Plugins-panel "Open chrome://extensions" button launches (default: first of google-chrome, chromium, brave-browser, microsoft-edge on PATH)
# BROWSER_SEARCH_BROWSER=google-chrome

# Obsidian export (optional). The Obsidian plugin card normally finds your vaults through
# Obsidian's own registry; set this to force a vault path instead — e.g. a vault on a network
# share, or a machine without Obsidian installed (the exporter only writes Markdown files).
# OBSIDIAN_VAULT=/home/you/obsidian_vault
